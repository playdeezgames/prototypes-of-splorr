package cryptogram

// The bank: public-domain proverbs and sayings (traditional, Poor Richard's Almanack, Aesop's
// morals). Each is enciphered under a fresh key when it is dealt.

Crypt :: struct {
	text:   string,
	source: string,
}

BANK := [?]Crypt {
	{"EARLY TO BED AND EARLY TO RISE, MAKES A MAN HEALTHY, WEALTHY, AND WISE.", "BENJAMIN FRANKLIN"},
	{"A PENNY SAVED IS A PENNY EARNED.", "PROVERB"},
	{"WELL DONE IS BETTER THAN WELL SAID.", "BENJAMIN FRANKLIN"},
	{"LOST TIME IS NEVER FOUND AGAIN.", "BENJAMIN FRANKLIN"},
	{"HE THAT LIES DOWN WITH DOGS, SHALL RISE UP WITH FLEAS.", "BENJAMIN FRANKLIN"},
	{"THREE MAY KEEP A SECRET, IF TWO OF THEM ARE DEAD.", "BENJAMIN FRANKLIN"},
	{"FISH AND VISITORS STINK IN THREE DAYS.", "BENJAMIN FRANKLIN"},
	{"AN OUNCE OF PREVENTION IS WORTH A POUND OF CURE.", "BENJAMIN FRANKLIN"},
	{"HUNGER NEVER SAW BAD BREAD.", "BENJAMIN FRANKLIN"},
	{"A SMALL LEAK WILL SINK A GREAT SHIP.", "BENJAMIN FRANKLIN"},
	{"NEVER LEAVE THAT TILL TOMORROW, WHICH YOU CAN DO TODAY.", "BENJAMIN FRANKLIN"},
	{"THE DOORS OF WISDOM ARE NEVER SHUT.", "BENJAMIN FRANKLIN"},
	{"GOD HELPS THEM THAT HELP THEMSELVES.", "BENJAMIN FRANKLIN"},
	{"SLOW AND STEADY WINS THE RACE.", "AESOP"},
	{"LOOK BEFORE YOU LEAP.", "AESOP"},
	{"DO NOT COUNT YOUR CHICKENS BEFORE THEY ARE HATCHED.", "AESOP"},
	{"UNION GIVES STRENGTH.", "AESOP"},
	{"A LIAR WILL NOT BE BELIEVED, EVEN WHEN HE SPEAKS THE TRUTH.", "AESOP"},
	{"IT IS EASY TO BE BRAVE FROM A SAFE DISTANCE.", "AESOP"},
	{"APPEARANCES ARE OFTEN DECEPTIVE.", "AESOP"},
	{"NO ACT OF KINDNESS, NO MATTER HOW SMALL, IS EVER WASTED.", "AESOP"},
	{"THE GODS HELP THEM THAT HELP THEMSELVES.", "AESOP"},
	{"BIRDS OF A FEATHER FLOCK TOGETHER.", "PROVERB"},
	{"A ROLLING STONE GATHERS NO MOSS.", "PROVERB"},
	{"WHEN THE CAT IS AWAY, THE MICE WILL PLAY.", "PROVERB"},
	{"DON'T PUT ALL YOUR EGGS IN ONE BASKET.", "PROVERB"},
	{"TOO MANY COOKS SPOIL THE BROTH.", "PROVERB"},
	{"ALL THAT GLITTERS IS NOT GOLD.", "PROVERB"},
	{"THE EARLY BIRD CATCHES THE WORM.", "PROVERB"},
	{"A WATCHED POT NEVER BOILS.", "PROVERB"},
	{"STILL WATERS RUN DEEP.", "PROVERB"},
	{"MANY HANDS MAKE LIGHT WORK.", "PROVERB"},
	{"YOU CAN LEAD A HORSE TO WATER, BUT YOU CAN'T MAKE IT DRINK.", "PROVERB"},
	{"PEOPLE WHO LIVE IN GLASS HOUSES SHOULD NOT THROW STONES.", "PROVERB"},
	{"THE PEN IS MIGHTIER THAN THE SWORD.", "EDWARD BULWER-LYTTON"},
	{"BETTER LATE THAN NEVER.", "PROVERB"},
	{"EVERY CLOUD HAS A SILVER LINING.", "PROVERB"},
	{"A JOURNEY OF A THOUSAND MILES BEGINS WITH A SINGLE STEP.", "LAO TZU"},
	{"WHERE THERE'S A WILL, THERE'S A WAY.", "PROVERB"},
	{"NECESSITY IS THE MOTHER OF INVENTION.", "PROVERB"},
	{"FORTUNE FAVOURS THE BOLD.", "PROVERB"},
	{"IF AT FIRST YOU DON'T SUCCEED, TRY, TRY AGAIN.", "PROVERB"},
	{"THE PROOF OF THE PUDDING IS IN THE EATING.", "PROVERB"},
	{"DON'T CROSS THE BRIDGE TILL YOU COME TO IT.", "PROVERB"},
	{"ABSENCE MAKES THE HEART GROW FONDER.", "PROVERB"},
	{"BREVITY IS THE SOUL OF WIT.", "WILLIAM SHAKESPEARE"},
	{"ALL THE WORLD'S A STAGE, AND ALL THE MEN AND WOMEN MERELY PLAYERS.", "WILLIAM SHAKESPEARE"},
	{"THE BETTER PART OF VALOUR IS DISCRETION.", "WILLIAM SHAKESPEARE"},
	{"NEITHER A BORROWER NOR A LENDER BE.", "WILLIAM SHAKESPEARE"},
	{"WHAT'S DONE CANNOT BE UNDONE.", "WILLIAM SHAKESPEARE"},
}
